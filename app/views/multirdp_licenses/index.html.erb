<div class="contextual">
  <%= link_to sprite_icon('add', l(:label_multirdp_license_new)), new_multirdp_license_path, class: 'icon icon-add' %>
</div>

<h2><%= l(:label_multirdp_licenses) %></h2>

<% unless MultirdpLicenses::Encryption.ready? %>
  <div class="flash warning"><%= l(:text_multirdp_encryption_missing, env: MultirdpLicenses::Encryption::ENV_NAME, file: MultirdpLicenses::Encryption.key_file_path) %></div>
<% end %>

<% if @licenses.empty? %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% else %>
  <table class="list">
    <thead><tr>
      <th><%= l(:field_name) %></th>
      <th><%= l(:field_multirdp_kind) %></th>
      <th><%= l(:field_multirdp_revision) %></th>
      <th><%= l(:label_multirdp_server_plural) %></th>
      <th><%= l(:label_multirdp_app_plural) %></th>
      <th><%= l(:label_multirdp_grant_plural) %></th>
      <th><%= l(:field_multirdp_grace_days) %></th>
      <th></th>
    </tr></thead>
    <tbody>
    <% @licenses.each do |license| %>
      <tr class="<%= cycle('odd', 'even') %>">
        <td class="name"><%= link_to h(license.name), multirdp_license_path(license) %></td>
        <td><%= h license.kind_label %></td>
        <td><%= license.revision %></td>
        <td><%= license.servers.size %></td>
        <td><%= license.apps.size %></td>
        <td><%= @grant_counts[license.id] || 0 %></td>
        <td><%= license.grace_days %></td>
        <td class="buttons">
          <%= link_to sprite_icon('edit', l(:button_edit)), edit_multirdp_license_path(license), class: 'icon icon-edit' %>
          <%= link_to sprite_icon('del', l(:button_delete)), multirdp_license_path(license), method: :delete,
                      data: { confirm: l(:text_are_you_sure) }, class: 'icon icon-del' %>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
<% end %>

<% html_title l(:label_administration), l(:label_multirdp_licenses) %>
