<h2><%= link_to l(:label_multirdp_licenses), multirdp_licenses_path %> &#187; <%= l(:label_multirdp_license_new) %></h2>
<%= labelled_form_for @license, as: :license, url: multirdp_licenses_path, html: { multipart: true, id: 'multirdp-license-form' } do |f| %>
  <%= render partial: 'form', locals: { f: f } %>
  <%= submit_tag l(:button_create) %>
<% end %>
<% html_title l(:label_administration), l(:label_multirdp_licenses), l(:label_multirdp_license_new) %>
